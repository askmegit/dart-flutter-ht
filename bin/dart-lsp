#!/bin/sh

fvm_cache_path=${FVM_CACHE_PATH:-$HOME/fvm}
project_dir=$PWD
project_version=
project_version_file=

while :; do
  if [ -f "$project_dir/.fvmrc" ]; then
    project_version_file=$project_dir/.fvmrc
    project_version=$(sed -n 's/.*"flutter"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$project_version_file" | sed -n '1p')
    break
  fi
  if [ -f "$project_dir/.fvm/fvm_config.json" ]; then
    project_version_file=$project_dir/.fvm/fvm_config.json
    project_version=$(sed -n 's/.*"flutterSdkVersion"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$project_version_file" | sed -n '1p')
    break
  fi
  [ "$project_dir" = / ] && break
  project_dir=${project_dir%/*}
  [ -n "$project_dir" ] || project_dir=/
done
if [ -n "$project_version_file" ] && [ -z "$project_version" ]; then
  printf 'dart-lsp: could not parse Flutter SDK version from %s; falling back to FVM default or PATH\n' "$project_version_file" >&2
fi

pinned_dart=
if [ -n "$project_version" ]; then
  pinned_dart=$fvm_cache_path/versions/$project_version/bin/cache/dart-sdk/bin/dart
fi
default_dart=$fvm_cache_path/default/bin/cache/dart-sdk/bin/dart

selected_dart=
if [ -n "$pinned_dart" ] && [ -x "$pinned_dart" ]; then
  selected_dart=$pinned_dart
elif [ -x "$default_dart" ]; then
  selected_dart=$default_dart
else
  selected_dart=$(command -v dart 2>/dev/null || :)
fi

if [ -z "$selected_dart" ] || [ ! -x "$selected_dart" ]; then
  printf '%s\n' 'dart-lsp: no executable Dart SDK found (checked project FVM version, FVM default, and PATH).' >&2
  exit 127
fi

case $selected_dart in
  /*) ;;
  *) selected_dart=$(cd "$(dirname "$selected_dart")" 2>/dev/null && printf '%s/%s\n' "$PWD" "$(basename "$selected_dart")") || {
    printf '%s\n' 'dart-lsp: cannot resolve selected Dart SDK path.' >&2
    exit 127
  } ;;
esac

if [ -n "$pinned_dart" ] && [ ! -x "$pinned_dart" ]; then
  printf 'dart-lsp: pinned Flutter %s SDK is not installed; falling back to %s\n' "$project_version" "$selected_dart" >&2
fi

if [ "${DART_LSP_PRINT:-}" = 1 ]; then
  printf '%s\n' "$selected_dart"
  exit 0
fi

idle_seconds=${DART_LSP_IDLE_SECONDS:-600}
case $idle_seconds in
  ''|*[!0-9]*)
    printf 'dart-lsp: DART_LSP_IDLE_SECONDS=%s is not a non-negative integer; using default 600\n' "$idle_seconds" >&2
    idle_seconds=600
    ;;
esac

if [ "$idle_seconds" -gt 0 ]; then
  bin_dir=$(dirname "$0")
  idle_wrapper=$bin_dir/dart-lsp-idle
  # `command -v python3` only proves a binary exists on PATH, not that it
  # actually runs (e.g. macOS's Xcode CLT stub, or an unconfigured pyenv
  # shim, both exit non-zero without doing anything useful). Actually
  # invoke it on a no-op before trusting it.
  if [ -f "$idle_wrapper" ] && command -v python3 >/dev/null 2>&1 && python3 -c '' >/dev/null 2>&1; then
    exec python3 "$idle_wrapper" "$idle_seconds" "$selected_dart" language-server --protocol=lsp
  fi
  printf 'dart-lsp: no usable python3 on PATH (or dart-lsp-idle missing); running without idle auto-exit\n' >&2
fi

exec "$selected_dart" language-server --protocol=lsp
